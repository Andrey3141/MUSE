<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/artwork"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:background="@color/muse_surface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muse_on_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/trackArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muse_on_dark_secondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/trackAlbum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muse_on_dark_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/sourceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muse_on_dark_muted"
            android:textSize="10sp"
            android:paddingTop="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>